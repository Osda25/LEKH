// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CARETAKER
  ADMIN
}

enum UnitCondition {
  IN_SERVICE
  OUT_OF_SERVICE
}

enum FaultReportStatus {
  OPEN
  REVIEWED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  RETURN_REQUESTED
  RETURNED
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  phone        String
  passwordHash String
  role         Role          @default(USER)
  faultReports FaultReport[]
  loans        Loan[]
}

model EquipmentType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  category    String
  description String?
  code        String  @unique

  units    EquipmentUnit[]
  guides   EquipmentGuide[]
  problems KnownProblem[]
}

model EquipmentUnit {
  id           Int           @id @default(autoincrement())
  identifier   String        @unique
  location     String
  condition    UnitCondition @default(IN_SERVICE)
  faultReports FaultReport[]
  loans        Loan[]

  equipmentTypeId Int
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
}

model EquipmentGuide {
  id      Int     @id @default(autoincrement())
  title   String
  content String
  url     String?

  equipmentTypeId Int
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
}

model FaultReport {
  id          Int               @id @default(autoincrement())
  title       String
  description String
  reviewNote  String?
  status      FaultReportStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  reviewedAt  DateTime?

  equipmentUnitId Int
  equipmentUnit   EquipmentUnit @relation(fields: [equipmentUnitId], references: [id])

  reportedById Int
  reportedBy   User @relation(fields: [reportedById], references: [id])
}

model KnownProblem {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  equipmentTypeId Int
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
}

model Loan {
  id           Int        @id @default(autoincrement())
  status       LoanStatus @default(PENDING)
  startDate    DateTime   @db.Date
  endDate      DateTime   @db.Date
  createdAt    DateTime   @default(now())
  approvedAt   DateTime?
  checkedOutAt DateTime?
  returnedAt   DateTime?

  equipmentUnitId Int
  equipmentUnit   EquipmentUnit @relation(fields: [equipmentUnitId], references: [id])
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
}
