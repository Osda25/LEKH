// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CARETAKER
  ADMIN
}

enum UnitCondition {
  IN_SERVICE
  OUT_OF_SERVICE
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  phone        String
  passwordHash String
  role         Role   @default(USER)
  faultReports FaultReport[]
}

model EquipmentType {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  category    String
  description String?
  code        String           @unique          

  units       EquipmentUnit[]
  guides      EquipmentGuide[]
}

model EquipmentUnit {
  id            Int           @id @default(autoincrement())
  identifier    String        @unique
  location      String
  condition     UnitCondition @default(IN_SERVICE)
  faultReports  FaultReport[]

  equipmentTypeId Int
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
}

model EquipmentGuide {
  id      Int     @id @default(autoincrement())
  title   String
  content String
  url     String?

  equipmentTypeId Int
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])
}

model FaultReport {
  id              Int     @id @default(autoincrement())
  title           String
  description     String
  createdAt       DateTime @default(now())

  equipmentUnitId Int
  equipmentUnit   EquipmentUnit @relation(fields: [equipmentUnitId], references: [id])

  reportedById    Int
  reportedBy      User  @relation(fields: [reportedById], references: [id])
}