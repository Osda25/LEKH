meta {
  name: Invalid category - 400
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/equipment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Bruno Invalid Category Test",
    "category": "THIS_CATEGORY_DOES_NOT_EXIST",
    "description": "Expected to fail validation."
  }
}

tests {
  test("Returns HTTP 400", function () {
    expect(res.status).to.equal(400);
  });
}

docs {
Requires a CARETAKER/ADMIN token, otherwise role middleware will return 403 before input validation.
}
