meta {
  name: Report known type peroblem
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/equipment/{{equipmentId}}/problems
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Firmware compatibility issue",
    "description": "This equipment model may fail to connect when using firmware version 2.1."
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
