meta {
  name: Register user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Test User",
    "email": "{{loginEmail}}",
    "phone": "0701234567",
    "password": "{{loginPassword}}"
  }
}

tests {
  test("Returns HTTP 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
Creates a USER account. A second request with the same email should return 409 Conflict.
}
