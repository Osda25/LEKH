meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{loginEmail}}",
    "password": "{{loginPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const data = res.getBody();
    if (data && data.token) {
      bru.setVar('token', data.token);
    }
  }
}

tests {
  test("Returns HTTP 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
Stores JWT as a runtime variable named token, available to other requests. Use the Secrets tab of the Local environment to set loginEmail/loginPassword.
}
